import { VerticalBox, HorizontalBox, Button, ComboBox } from "std-widgets.slint";

struct BodySprite {
    name: string,
    x_px: float,
    y_px: float,
    radius_px: float,
    color: color,
}

export component MainWindow inherits Window {
    title: "xbsol";
    min-width: 960px;
    min-height: 700px;
    preferred-width: 960px;
    preferred-height: 700px;
    private property <duration> auto_tick_interval: 50ms;
    private property <length> layout_padding: 16px;
    private property <length> layout_spacing: 10px;
    private property <length> scene_min_height: 520px;
    private property <color> scene_background: #0a0f1a;
    private property <color> scene_border_color: #243752;
    private property <length> scene_border_width: 1px;

    in-out property <string> date_text: "No data";
    in-out property <[BodySprite]> body_sprites: [];
    out property <float> scene_width: scene.width / 1px;
    out property <float> scene_height: scene.height / 1px;

    // Kamera-State (hybrid): Source-of-truth in Rust, Spiegelung in Slint.
    in-out property <float> camera_azimuth_deg: 0;
    in-out property <float> camera_elevation_deg: 0;
    in-out property <float> camera_distance_au: 0;
    in-out property <float> camera_fov_deg: 0;
    in-out property <string> selected_center_name: "Sun";

    callback prev_day();
    callback next_day();
    callback toggle_auto_play();
    callback auto_tick();
    callback select_center(name: string);
    callback scene_resized(viewport_width_px: float, viewport_height_px: float);
    callback orbit_camera(delta_x_px: float, delta_y_px: float);
    callback pan_camera(delta_x_px: float, delta_y_px: float, viewport_width_px: float, viewport_height_px: float);
    callback zoom_camera(delta_steps: float);
    callback camera_key(action: string);

    changed scene_width => {
        root.scene_resized(root.scene_width, root.scene_height);
    }

    changed scene_height => {
        root.scene_resized(root.scene_width, root.scene_height);
    }

    Timer {
        running: root.auto_play;
        interval: root.auto_tick_interval;
        triggered => {
            root.auto_tick();
            if (root.auto_play) {
                root.auto_play = false;
                root.auto_play = true;
            }
        }
    }

    in-out property <bool> auto_play: false;

    input_scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == "a" || event.text == "A") {
                root.camera_key("pan_left");
                accept;
            } else if (event.text == "d" || event.text == "D") {
                root.camera_key("pan_right");
                accept;
            } else if (event.text == "w" || event.text == "W") {
                root.camera_key("pan_up");
                accept;
            } else if (event.text == "s" || event.text == "S") {
                root.camera_key("pan_down");
                accept;
            } else if (event.text == "j" || event.text == "J") {
                root.camera_key("orbit_left");
                accept;
            } else if (event.text == "l" || event.text == "L") {
                root.camera_key("orbit_right");
                accept;
            } else if (event.text == "i" || event.text == "I") {
                root.camera_key("orbit_up");
                accept;
            } else if (event.text == "k" || event.text == "K") {
                root.camera_key("orbit_down");
                accept;
            } else if (event.text == "+" || event.text == "=") {
                root.camera_key("zoom_in");
                accept;
            } else if (event.text == "-") {
                root.camera_key("zoom_out");
                accept;
            } else {
                reject;
            }
        }

        VerticalBox {
            width: 100%;
            height: 100%;
            padding: root.layout_padding;
            spacing: root.layout_spacing;

        Text {
            text: root.date_text;
            horizontal-alignment: center;
            font-size: 20px;
        }

        HorizontalBox {
            spacing: 8px;
            ComboBox {
                width: 180px;
                model: ["Sun", "Mercury", "Venus", "Earth", "Moon", "Mars", "Jupiter", "Io", "Europa", "Ganymede", "Callisto"];
                current-value: root.selected_center_name;
                selected => {
                    root.selected_center_name = self.current-value;
                    root.select_center(self.current-value);
                }
            }
        }

        scene := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            min-height: root.scene_min_height;
            background: root.scene_background;
            border-color: root.scene_border_color;
            border-width: root.scene_border_width;

            property <bool> drag_active: false;
            property <bool> drag_pan: false;
            property <float> drag_last_x: 0;
            property <float> drag_last_y: 0;

            TouchArea {
                width: parent.width;
                height: parent.height;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        scene.drag_active = true;
                        scene.drag_pan = event.button == PointerEventButton.right;
                        scene.drag_last_x = self.mouse-x / 1px;
                        scene.drag_last_y = self.mouse-y / 1px;
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        scene.drag_active = false;
                        scene.drag_pan = false;
                    }
                }

                clicked => {
                    input_scope.focus();
                }

                moved => {
                    if (scene.drag_active) {
                        let current_x = self.mouse-x / 1px;
                        let current_y = self.mouse-y / 1px;
                        let delta_x = current_x - scene.drag_last_x;
                        let delta_y = current_y - scene.drag_last_y;
                        if (scene.drag_pan) {
                            root.pan_camera(delta_x, delta_y, root.scene_width, root.scene_height);
                        } else {
                            root.orbit_camera(delta_x, delta_y);
                        }
                        scene.drag_last_x = current_x;
                        scene.drag_last_y = current_y;
                    } else {
                        scene.drag_active = false;
                    }
                }

                scroll-event(event) => {
                    root.zoom_camera(event.delta-y / 120px);
                    accept;
                }
            }

            for body[i] in root.body_sprites : Rectangle {
                width: body.radius_px * 2px;
                height: body.radius_px * 2px;
                x: body.x_px * 1px - self.width / 2;
                y: body.y_px * 1px - self.height / 2;
                border-radius: self.width / 2;
                background: body.color;
            }
        }

            HorizontalBox {
                spacing: 12px;

                Button {
                    text: "← Prev day";
                    clicked => { root.prev_day(); }
                }

                Button {
                    text: "Next day →";
                    clicked => { root.next_day(); }
                }

                Button {
                    text: root.auto_play ? "Stop" : "Auto";
                    clicked => {
                        root.auto_play = !root.auto_play;
                        root.toggle_auto_play();
                    }
                }
            }
        }
    }
}

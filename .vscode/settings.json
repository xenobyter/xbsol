{
    "cSpell.words": [
        "ascii",
        "Ephem",
        "EPHEM",
        "ephemerides",
        "ephems",
        "nasa",
        "parst",
        "Plattformfehler",
        "slint",
        "Slint",
        "Szenendarstellung"
    ],
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    "editor.formatOnSave": true,
    "rust-analyzer.rustfmt.extraArgs": [
        "--config",
        "max_width=140"
    ],
    "chat.tools.terminal.autoApprove": {
        "cargo run": true
    }
}